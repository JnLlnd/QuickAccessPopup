SplitHotstring(strHotstring, ByRef strTrigger, ByRef strOptionsShort)
;------------------------------------------------------------
{
	saHotstring := StrSplit(strHotstring, ":")
	strTrigger := saHotstring[3]
	strOptionsShort := saHotstring[2]
	
	return StrLen(saHotstring[1])
}
