CleanUpBeforeExit:
;-----------------------------------------------------------

; if (o_Settings.Launch.blnDiagMode.IniValue)
	; Diag("ListLines", ScriptInfo("ListLines"), "")

if (o_Settings.Launch.blnDiagMode.IniValue) and !FileExist("C:\Dropbox\AutoHotkey\QuickAccessPopup\QuickAccessPopup-HOME.ini")
