;------------------------------------------------------------
GetOSVersion()
;------------------------------------------------------------
{
	if (GetOSVersionInfo().MajorVersion = 10)
		if (GetOSVersionInfo().BuildNumber >= 22000)
			return "WIN_11"
		else
			return "WIN_10"
	else
		return A_OSVersion
}
