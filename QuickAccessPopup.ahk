	{
		DriveGet, intCapacity, Capacity, %strPath%
		DriveSpaceFree, intFreeSpace,  %strPath%
		DriveGet, strDriveLabel, Label, %strPath%
		DriveGet, strDriveType, Type, %strPath% ; Unknown, Removable, Fixed, Network, CDROM, RAMDisk
	}
	else
