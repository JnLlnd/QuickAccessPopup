	;---------------------------------------------------------
	ContainerCount()
	; number of items not hidden in menus or not disabled in groups
	; intFavoriteDisabled: enabled+visible (0), disabled+hidden (1), enabled+hidden (-1)
	;---------------------------------------------------------
	{
		intCount := 0
		for intKey, oItem in this.SA
			if !(oItem.AA.intFavoriteDisabled)
				intCount++
		return intCount
	}
