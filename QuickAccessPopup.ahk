		Gui, 2:Add, Radio, % "x20 y+10 vf_intRadioOpenSubFolderOrder1 " . (o_EditedFavorite.AA.intFavoriteOpenSubFolder > 0 ? "checked" : ""), % o_L["DialogOpenSubFolderMostRecently"] . g_strEllipse
