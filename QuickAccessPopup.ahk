Loop, Files, %g_strTempDirParent%\_QAP_temp_*,  D
{
	strDate := A_Now
	EnvSub, strDate, %A_LoopFileTimeModified%, D
	if (strDate > 5)
	{
		FileRemoveDir, %A_LoopFileFullPath%, 1 ; Remove all files and subdirectories
		Sleep, 10000 ; wait 10 second
	}
}

