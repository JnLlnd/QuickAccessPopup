PickRandomNumber(str)
;------------------------------------------------------------
{
	saBetween := StrSplit(str, "|")
	strRandomResult := RandomBetween(saBetween[1], saBetween[2], (StrLen(saBetween[3]) ? saBetween[3] : 0))
	
	return strRandomResult
}
