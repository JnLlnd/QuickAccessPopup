;------------------------------------------------------------
GetWindowsAppIcon(strAppID, ByRef strIconFile)
;------------------------------------------------------------
{
	strTempLnk := g_strTempDir . "\" . "temp.lnk"
	
	; Tip from rommmcek to extract a .lnk icon for this app (https://www.autohotkey.com/boards/viewtopic.php?p=590005#p590005)
	; We just have to accept the the icon includes the small arrow in the lower left corder of the icon indicating that it is a link.
	oShell := ComObjCreate("WScript.Shell")
	oShortcut := oShell.CreateShortcut(strTempLnk)
	oShortcut.TargetPath := "shell:AppsFolder\" . strAppID
	oShortcut.Save()

	intIconIndex:= 0
	hIcon := DllCall("Shell32\ExtractAssociatedIcon", "Ptr", 0, "Str", strTempLnk, "ShortP", intIconIndex, "Ptr")
	strIconFile := g_strTempDir . "\" . strAppID . ".ico"
	SaveHICONtoFile(hicon, strIconFile)
	FileDelete, %strTempLnk%
}
