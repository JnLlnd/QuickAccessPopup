if (WinExist("A") <> g_strGui1Hwnd)
	WinActivate, ahk_id %g_strGui1Hwnd%

strThisTitle := ""
blnIsAddEditCopyFavorite := ""
blnIsToMenuDialogBox := ""
intMinMax := ""
intX := ""
intY := ""
intW := ""
intH := ""

