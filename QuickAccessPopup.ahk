	;-------------------------------------------------------------
	AddCustomizeThisMenu()
	;-------------------------------------------------------------
	{
		Menu, % this.AA.strMenuPath, Add
		this.AddMenuIcon(o_L["MenuCustomizeThisMenu"], "GuiShowFromEditThisMenu", "iconEditFavorite")
	}
