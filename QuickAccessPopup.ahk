;------------------------------------------------------------
OptionsListCleanup(strList)
;------------------------------------------------------------
{
	strListCleanup := StrReplace(strList, "`n", "|")
	strList := ""
	Loop, Parse, strListCleanup, |
		if StrLen(A_LoopField)
			strList .= Trim(A_LoopField) . "|"
	strList := SubStr(strList, 1, -1) ; remove last |
	return strList
}
